<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bound on Moves Analysis list (Inventory → Reporting → Moves Analysis) -->
    <record id="stock_move_line_cancel" model="ir.actions.server">
        <field name="name">Cancel</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.bulk_stock_move_line_cancel()
        </field>
    </record>

    <record id="stock_move_line_cancel_reset" model="ir.actions.server">
        <field name="name">Cancel &amp; Reset Draft</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.bulk_stock_move_line_cancel_reset()
        </field>
    </record>
</odoo>
