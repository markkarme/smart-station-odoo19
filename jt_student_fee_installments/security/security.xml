<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_student_fee_installments" model="ir.module.category">
        <field name="name">Student Fee Installments</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_fee_installments" model="res.groups.privilege">
        <field name="name">Fee Installments</field>
        <field name="category_id" ref="module_category_student_fee_installments"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_fee_installment_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_fee_installments"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_fee_installment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_fee_installments"/>
        <field name="implied_ids" eval="[(4, ref('group_fee_installment_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="student_fee_plan_company_rule" model="ir.rule">
        <field name="name">Student Fee Plan: multi-company</field>
        <field name="model_id" ref="model_student_fee_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="student_fee_installment_company_rule" model="ir.rule">
        <field name="name">Student Fee Installment: multi-company</field>
        <field name="model_id" ref="model_student_fee_installment"/>
        <field name="domain_force">[('plan_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="student_fee_other_company_rule" model="ir.rule">
        <field name="name">Student Other Fee: multi-company</field>
        <field name="model_id" ref="model_student_fee_other"/>
        <field name="domain_force">[('plan_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
