<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_fee_installment_list" model="ir.ui.view">
        <field name="name">student.fee.installment.list</field>
        <field name="model">student.fee.installment</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="year_id"/>
                <field name="fee_type"/>
                <field name="number"/>
                <field name="amount_due" sum="Due"/>
                <field name="amount_paid" sum="Paid"/>
                <field name="receipt_number"/>
                <field name="payment_date"/>
                <field name="is_paid"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_student_fee_other_list" model="ir.ui.view">
        <field name="name">student.fee.other.list</field>
        <field name="model">student.fee.other</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="year_id"/>
                <field name="fee_type"/>
                <field name="amount" sum="Total"/>
                <field name="receipt_number"/>
                <field name="payment_date"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_student_fee_installment" model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">student.fee.installment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_student_fee_other" model="ir.actions.act_window">
        <field name="name">Other Fees</field>
        <field name="res_model">student.fee.other</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
