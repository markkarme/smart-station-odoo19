<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_fee_plans_wizard_form" model="ir.ui.view">
        <field name="name">generate.fee.plans.wizard.form</field>
        <field name="model">generate.fee.plans.wizard</field>
        <field name="arch" type="xml">
            <form string="إنشاء خطط الرسوم">
                <group>
                    <group>
                        <field name="year_id"/>
                        <field name="standard_id"/>
                        <field name="basic_installment_count"/>
                        <field name="bus_installment_count"/>
                    </group>
                    <group>
                        <field name="default_basic_total_due"/>
                        <field name="bus_category_id"/>
                        <field name="default_bus_total_due"/>
                        <field name="default_books_amount"/>
                        <field name="overwrite_due"/>
                        <field name="student_count"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" string="إنشاء" type="object" class="btn-primary"/>
                    <button string="إلغاء" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_fee_plans_wizard" model="ir.actions.act_window">
        <field name="name">إنشاء خطط الرسوم</field>
        <field name="res_model">generate.fee.plans.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
