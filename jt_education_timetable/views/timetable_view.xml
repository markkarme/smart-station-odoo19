<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="student_time_table_form" model="ir.ui.view">
            <field name="name">student.timetable.form</field>
            <field name="model">student.timetable</field>
            <field name="arch" type="xml">
                <form string="Student Timetable">
                    <header>
                        <button name="timetable_validate" string="Validate" type="object" class="oe_highlight" invisible="state not in ('draft')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,validate"></field>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" default_focus="1" placeholder="Name" readonly="1" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="standard" required='1'/>
                                <field name="division" required='1'/>
                                <field name="curr_year" required='1'/>
                            </group>
                            <group>
                                <field name="duration" widget='float_time' required='1'/>
                                <field name="lec_start_time" widget='float_time' required='1'/>
                            </group>
                        </group>
                        <!-- <group>
                            <field name="student_ids" domain="[('standard','=',standard),('div','=',division),('curr_year','=',curr_year)]">
                                <list>
                                    <field name="name" required='1'/>
                                    <field name="standard" required='1'/>
                                    <field name="div" required='1'/>
                                    <field name="roll_no" required='1'/>
                                </list>
                            </field>
                        </group> -->
                        <notebook>
                            <page string="Monday">
                                <field name="timetable_mon" domain="[('week_day','=', 0)]"  context="{'default_week_day': '0'} " readonly = "state not in ('draft')">
                                    <list string="Monday" editable="bottom">
                                        <!-- <field name="date" options = '{"datepicker":{"daysOfWeekDisabled":[0,2,3,4,5,6]}}' required='1'/> -->
                                        <field name="sequence" widget="handle"/>
                                        <field name="faculty_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True}" required='1'/>
                                        <field name="subject" required='1'/>
                                        <!-- <field name="period_id" required='1'/> -->
                                        <field name="time_from" widget="float_time" required='1'/>
                                        <field name="time_till" widget="float_time" required='1'/>
                                        <field name="week_day" column_invisible='1' />
                                    </list>
                                </field>
                            </page>
                            <page string="Tuesday">
                                <field name="timetable_tue" domain="[('week_day','=', 1)]"  context="{'default_week_day': '1'}" readonly = "state not in ('draft')">
                                    <list string="Tuesday" editable="bottom">
                                        <!-- <field name="period_id" required='1'/> -->
                                        <!-- <field name="date" options = '{"datepicker":{"daysOfWeekDisabled":[0,1,3,4,5,6]}}' required='1'/> -->
                                        <field name="sequence" widget="handle" />

                                        <field name="faculty_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True}" required='1'/>
                                        <field name="subject" required='1'/>
                                        <field name="time_from" widget="float_time" required='1'/>
                                        <field name="time_till" widget="float_time" required='1'/>
                                        <field name="week_day" column_invisible='1'/>
                                    </list>
                                </field>
                            </page>
                            <page string="Wednesday">
                                <field name="timetable_wed" domain="[('week_day','=', 2)]"  context="{'default_week_day': '2'}" readonly = "state not in ('draft')">
                                    <list string="Wednesday" editable="bottom">
                                        <!-- <field name="period_id" required='1'/> -->
                                        <!-- <field name="date" options = '{"datepicker":{"daysOfWeekDisabled":[0,2,1,4,5,6]}}' required='1'/> -->
                                        <field name="sequence" widget="handle" />
                                        <field name="faculty_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True}" required='1'/>
                                        <field name="subject" required='1'/>
                                        <field name="time_from" required='1'/>
                                        <field name="time_till" required='1'/>
                                        <field name="week_day" column_invisible='1'/>
                                    </list>
                                </field>
                            </page>
                            <page string="Thursday">
                                <field name="timetable_thur" domain="[('week_day','=', 3)]"  context="{'default_week_day': '3'}" readonly = "state not in ('draft')">
                                    <list string="Thursday" editable="bottom">
                                        <!-- <field name="date" options = '{"datepicker":{"daysOfWeekDisabled":[0,2,3,1,5,6]}}' required='1'/> -->
                                        <!-- <field name="period_id" required='1'/> -->
                                        <field name="sequence" widget="handle" />
                                        <field name="faculty_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True}" required='1'/>
                                        <field name="subject" required='1'/>
                                        <field name="time_from" widget="float_time" required='1'/>
                                        <field name="time_till" widget="float_time" required='1'/>
                                        <field name="week_day" column_invisible='1'/>
                                    </list>
                                </field>
                            </page>
                            <page string="Friday">
                                <field name="timetable_fri" domain="[('week_day','=', 4)]"  context="{'default_week_day': '4'}" readonly = "state not in ('draft')">
                                    <list string="Friday" editable="bottom">
                                        <!-- <field name="period_id" required='1'/> -->
                                        <!-- <field name="date" options = '{"datepicker":{"daysOfWeekDisabled":[0,2,3,4,1,6]}}' required='1'/> -->
                                        <field name="sequence" widget="handle" />
                                        <field name="faculty_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True}" required='1'/>
                                        <field name="subject" required='1'/>
                                        <field name="time_from" widget="float_time" required='1'/>
                                        <field name="time_till" widget="float_time" required='1'/>
                                        <field name="week_day" column_invisible='1'/>
                                    </list>
                                </field>
                            </page>
                            <page string="Saturday">
                                <field name="timetable_sat" domain="[('week_day','=', 5)]"  context="{'default_week_day': '5'}" readonly = "state not in ('draft')">
                                    <list string="Saturday" editable="bottom">
                                        <!-- <field name="period_id" required='1'/> -->
                                        <!-- <field name="date" options = '{"datepicker":{"daysOfWeekDisabled":[0,2,3,4,5,1]}}' required='1'/> -->
                                        <field name="sequence" widget="handle" />
                                        
                                        <field name="faculty_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True}" required='1'/>
                                        <field name="subject" required='1'/>
                                        <field name="time_from" widget="float_time" required='1'/>
                                        <field name="time_till" widget="float_time" required='1'/>
                                        <field name="week_day" column_invisible='1'/>
                                    </list>
                                </field>
                            </page>
                            <!-- <page string="Sunday">
                                <field name="timetable_sun" domain="[('week_day','=', 6)]"  context="{'default_week_day': '6'}">
                                    <list string="Sunday" editable="bottom">
                                        <field name="period_id" required='1'/>
                                        <field name="time_from" widget="float_time" required='1'/>
                                        <field name="time_till" widget="float_time" required='1'/>
                                        <field name="subject" required='1'/>
                                        <field name="faculty_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create':True}" required='1'/>
                                        <field name="date" options = '{"datepicker":{"daysOfWeekDisabled":[1,2,3,4,5,6]}}' required='1'/>
                                        <field name="week_day" invisible='1'/>
                                    </list>
                                </field>
                            </page> -->
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="student_time_table_tree" model="ir.ui.view">
            <field name="name">student.timetable.tree</field>
            <field name="model">student.timetable</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="standard"/>
                    <field name="division"/>
                    <field name="curr_year"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
