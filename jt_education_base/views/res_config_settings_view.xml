<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.education</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Education" string="Education" name="jt_education_base">
                    <block title="Allowed Days to pay fees" id="fees_payment">
                        <setting id="allowed_number_of_days_for_fees_payment" help="Number of days after admission before unpaid applications are cancelled.">
                            <field name="no_of_days"/>
                        </setting>
                    </block>
                    <block title="How Many Students For Rewards" id="student_reward">
                        <setting id="allowed_number_of_students_for_rewards" help="Number of students considered for rewards.">
                            <field name="student_for_reward"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
