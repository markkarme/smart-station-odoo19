<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="send_by_mail_template_remainder4" model="mail.template">
            <field name="name">Fee Details</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Fees Reminder</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Fee Details</p>
                    <p><strong>Fee Remainder:</strong></p>
                    <p>Kindly pay fees as mentioned.</p>
                    <p>Your outstanding fees: <strong><t t-out="ctx.get('fees') or ''"/></strong></p>
                    <p>Thank you.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
