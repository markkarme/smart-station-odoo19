<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="admission_cancel_template" model="mail.template">
            <field name="name">Admission Cancellation</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Admission Status Information</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Your admission has been cancelled</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
