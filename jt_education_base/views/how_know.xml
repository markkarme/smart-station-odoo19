<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="howknow_form_view" model="ir.ui.view">
        <field name="name">How Know Form View</field>
        <field name="model">how.know</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="howknow_tree_view" model="ir.ui.view">
        <field name="name">How Know Tree View</field>
        <field name="model">how.know</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name" required="1"/>
            </list>
        </field>
    </record>
</odoo>
