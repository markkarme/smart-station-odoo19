<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="admission_pending_fees_template" model="mail.template">
            <field name="name">Admission Pending Fees</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Fee Payment Reminder</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Your Fees Pending</p>
                    <p>
                        Your Application is submitted but the date is closed kindly pay your fees.
                    </p>
                    <p>Your outstanding fees: <strong><t t-out="ctx.get('fees') or ''"/></strong></p>
                </div>
            </field>
        </record>
    </data>
</odoo>
