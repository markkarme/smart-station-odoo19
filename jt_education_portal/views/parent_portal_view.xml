    </template>

    <template id="portal_parent_student_list" name="My Students">
        <t t-call="website.layout">
            <header>
                <div class="container" style="margin-top: 40px;">
                    <a href="/my/home" class="oe_highlight" ><i class="fa fa-home" aria-hidden="true"></i></a>
                    <span> / </span>
                    <span>Profile</span>
                </div>
            </header>
            <t t-set="additional_title">My Students</t>
            <div class="container" style="margin-top: 60px;">
                <div class="row mb-4">
                    <div class="col">
                        <h2 class="mb-4">My Students</h2>
                        <t t-if="students">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Standard</th>
                                        <th>Division</th>
                                        <th>Academic Year</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="students" t-as="student">
                                        <tr>
                                            <td><t t-esc="student.name" /></td>
                                            <td><t t-esc="student.standard.name" /></td>
                                            <td><t t-esc="student.div.name" /></td>
                                            <td><t t-esc="student.curr_year.name" /></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="not students">
                            <p>No students linked to your account.</p>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
    
    

</odoo>
