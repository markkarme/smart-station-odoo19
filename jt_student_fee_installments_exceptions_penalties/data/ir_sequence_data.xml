<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_student_fee_exception" model="ir.sequence">
        <field name="name">Student Fee Exception</field>
        <field name="code">student.fee.exception</field>
        <field name="prefix">EXC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_config_penalty_price_per_week" model="ir.config_parameter">
        <field name="key">jt_student_fee_installments_exceptions_penalties.penalty_price_per_week</field>
        <field name="value">50</field>
    </record>
</odoo>
