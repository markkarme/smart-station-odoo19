<odoo>
    <data noupdate="1">
        <record id="module_category_student_management" model="ir.module.category">
            <field name="name">Student Management</field>
            <field name="description">Student Management System</field>
            <field name="sequence">10</field>
        </record>

        <record id="res_groups_privilege_student_management_role" model="res.groups.privilege">
            <field name="name">Student Management Role</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_student_management"/>
            <field name="placeholder">No</field>
        </record>

        <record id="group_student_management_admin" model="res.groups">
            <field name="name">Student Management Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_student_management_role"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="group_student_management_restaurant" model="res.groups">
            <field name="name">Student Management Restaurant</field>
            <field name="privilege_id" ref="res_groups_privilege_student_management_role"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
