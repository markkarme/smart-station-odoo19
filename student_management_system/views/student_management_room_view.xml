<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="student_room_view_action" model="ir.actions.act_window">
        <field name="name">Room</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">student.management.room</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p style="color:green;">
                Create Room
            </p>
        </field>
    </record>

    <menuitem id="student_room_menu"
              name="Room"
              parent="student_management_config_menu"
              action="student_room_view_action"/>

    <record id="student_room_view_tree" model="ir.ui.view">
        <field name="name">student.room.view.tree</field>
        <field name="model">student.management.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Room Name"/>
                <field name="capacity"/>
                <field name="branch_id"/>
            </list>
        </field>
    </record>

    <record id="student_room_form_view" model="ir.ui.view">
        <field name="name">student.room.form.view</field>
        <field name="model">student.management.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="icon" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'icon'}"/>
                    <div class="oe_title">
                        <label for="name" string="Room Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="capacity"/>
                            <field name="branch_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="school_room_view_kanban" model="ir.ui.view">
        <field name="name">school.room.view.kanban</field>
        <field name="model">student.management.room</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="icon" widget="image" alt="Room" options="{'img_class': 'object-fit-contain'}"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="capacity"/>
                            <field name="branch_id"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
