<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privilege (group category) for Petty Cash -->
    <record model="res.groups.privilege" id="res_groups_privilege_petty_cash">
        <field name="name">Petty Cash</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="sequence">50</field>
    </record>

    <!-- User group -->
    <record id="petty_cash_user_group" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager group -->
    <record id="petty_cash_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('petty_cash_user_group'))]"/>
    </record>

    <!-- Record rules: users see only their own employee records -->
    <data noupdate="1">
        <record id="petty_cash_fund_user_rule" model="ir.rule">
            <field name="name">Petty Cash Fund: own employee only</field>
            <field name="model_id" ref="model_petty_cash_fund"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash_user_group'))]"/>
        </record>

        <record id="petty_cash_fund_manager_rule" model="ir.rule">
            <field name="name">Petty Cash Fund: manager all</field>
            <field name="model_id" ref="model_petty_cash_fund"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('petty_cash_manager_group'))]"/>
        </record>

        <record id="petty_cash_request_user_rule" model="ir.rule">
            <field name="name">Petty Cash Request: own employee only</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash_user_group'))]"/>
        </record>

        <record id="petty_cash_request_manager_rule" model="ir.rule">
            <field name="name">Petty Cash Request: manager all</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('petty_cash_manager_group'))]"/>
        </record>

        <record id="petty_cash_transaction_user_rule" model="ir.rule">
            <field name="name">Petty Cash Transaction: own employee only</field>
            <field name="model_id" ref="model_petty_cash_transaction"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash_user_group'))]"/>
        </record>

        <record id="petty_cash_transaction_manager_rule" model="ir.rule">
            <field name="name">Petty Cash Transaction: manager all</field>
            <field name="model_id" ref="model_petty_cash_transaction"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('petty_cash_manager_group'))]"/>
        </record>
    </data>
</odoo>
