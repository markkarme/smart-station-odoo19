<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hostel_housekeeping_form" model="ir.ui.view">
            <field name="name">Hostel Housekeeping</field>
            <field name="model">hostel.housekeeping</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required='1'></field>
                            </group>
                        </group>
                    </sheet>
                <chatter/>
                </form>
            </field>
        </record>

        <record id="hostel_registration_form" model="ir.ui.view">
            <field name="name">Hostel Registration</field>
            <field name="model">hostel.registration</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <!-- <button name="student_new" string="New" type="object" class="oe_highlight"/> -->
                        <button name="student_active" string="Active" type="object" invisible="state not in ('new')" class="oe_highlight"/>
                        <button name="student_cancel" string="Cancel" type="object" invisible="state not in ('new')" class="oe_highlight"/>
                        <button name="student_release" string="Release" type="object" invisible="state not in ('active')" class="oe_highlight"/>
                        <button name="create_invoice" string="Create Invoice" type="object" invisible="state not in ('active') or invoice_state not in ('to_invoice')" class="oe_highlight"/>
                        <field name="state" widget="statusbar" statusbar_visible="new,active,release"></field>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" class="oe_stat_button" icon="fa-money" name="action_view_fees_invoice" invisible="invoice_count == 0">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="invoice_count" invisible="1"/>
                                    </span>
                                    <span class="o_stat_text">Invoices</span>
                                </div>
                            </button>
                        </div>
                                <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>
                        <group>
                            <h1>
                                <field name="hostel_fee_seq"></field>
                            </h1>
                            <group>
                            </group>
                            <group>
                                <field name="student_id" required='1'></field>
                                <field name="building_id" required='1'></field>
                                <field name="room_id" required='1'></field>
                                <field name="room_type" required='1'></field>
                                <field name="invoice_state" readonly='1'></field>
                                <field name="payment_state" readonly='1'></field>

                            </group>
                            <group>
                                <field name="standard" readonly='1' force_save="1"></field>
                                <field name="division" readonly='1' force_save="1"></field>
                                <field name="curr_year_id" readonly='1' force_save="1"></field>
                            </group>
                        </group>
                        <notebook>
                            <page string="Fees">
                                <field name="registration_ids" sum="Total">
                                    <list editable='top'>
                                        <field name="housekeeping_id" required='1'></field>
                                        <field name="quantity" required='1'></field>
                                        <field name="amount" required='1'></field>
                                        <field name="total_fees" sum="Total Fees"></field>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                <chatter/>
                </form>
            </field>
        </record>

        
        <record id="hostel_registration_tree" model="ir.ui.view">
            <field name="name">Hostel Registration</field>
            <field name="model">hostel.registration</field>
            <field name="arch" type="xml">
                <list>
                    <field name="hostel_fee_seq"></field> 
                    <field name="student_id"></field>
                    <field name="room_id"></field>
                    <field name="standard"></field>
                    <field name="division"></field>
                    <field name="state"></field>
                </list>
            </field>
        </record>


        <record id="hostel_registration_line_tree" model="ir.ui.view">
            <field name="name">Hostel Registration Line</field>
            <field name="model">hostel.housekeeping</field>
            <field name="arch" type="xml">
                <list> 
                    <field name="name"></field>
                </list>
            </field>
        </record>

        
        <record id="hostel_housekeeping_pivot" model="ir.ui.view">
            <field name="name">Hostel Housekeeping Pivot</field>
            <field name="model">hostel.housekeeping</field>
            <field name="arch" type="xml">
                <pivot string="Hostel Housekeeping">
                    <field name="name" type="row"></field>
                </pivot>
            </field>
        </record>


        <record id="hostel_registration_pivot" model="ir.ui.view">
            <field name="name">Hostel Registration Pivot</field>
            <field name="model">hostel.registration</field>
            <field name="arch" type="xml">
                <pivot string="Hostel Registration">
                    <field name="student_id" type="row"></field>
                    <field name="room_id" type="col"></field>
                    <field name="standard"></field>
                    <field name="division"></field>
                    <field name="state"></field>
                </pivot>
            </field>
        </record>


        <record id="hostel_registration_kanban" model="ir.ui.view">
            <field name="name">hostel.registration.kanban.view</field>
            <field name="model">hostel.registration</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" quick_create="false" create="false">
                    <field name="student_id"></field>
                    <field name="room_id"></field>
                    <field name="standard"></field>
                    <field name="division"></field>
                    <field name="state"></field>
                    <field name="state"/>
                    <progressbar field="state" colors='{"new": "warning","active": "success",  "release": "danger","cancelled": "danger"}'/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                                <div class="o_kanban_image">
                                    <field name="image_1920" widget="image"/>
                                </div>
                                <div class="oe_kanban_content flex-grow-1">
                                    <div class="oe_kanban_details">
                                        <strong class="o_kanban_record_title"><field name="student_id"/></strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="standard" style="padding-left:7px;"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="division" style="padding-left:7px;"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="room_id" style="padding-left:70px;"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record model="ir.actions.act_window" id="action_hostel_registration">
            <field name="name">Hostel Registration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hostel.registration</field>
            <field name="view_mode">list,form,pivot,kanban</field>
        </record>

        <record model="ir.actions.act_window" id="action_housekeeping">
            <field name="name">Hostel Housekeeping</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hostel.housekeeping</field>
            <field name="view_mode">list,form,pivot</field>
        </record>

        <record id="sequence_hostel" model="ir.sequence">
            <field name="name">Hostel</field>
            <field name="code">hostel.sequence</field>
            <field name="prefix">HFS</field>
            <field name="padding">3</field>
        </record>

        <menuitem id="hostel_menu" name="Hostel" parent="jt_education_base.root_menu" 
            sequence="11" groups="jt_education_hostel.group_hostel"/>

        <menuitem id="hostel_registration_menu" name="Registration" sequence='1' 
            parent="hostel_menu" action="action_hostel_registration"/>

        <menuitem id="hostel_housekeeping_menu" name="Housekeeping" 
            parent="hostel_menu" action="action_housekeeping"/>


    </data>
</odoo>