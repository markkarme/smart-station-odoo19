<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="meeting_view_form" model="ir.ui.view">
            <field name="name">Parents Meeting</field>
            <field name="model">parent.meeting</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required='1'/>
                                <field name="standard" required='1'/>
                                <field name="division" required='1'/>
                            </group>
                            <group>
                                <field name="start_date" required='1'/>
                                <field name="end_date" required='1'/>
                                <field name="agenda" required='1'/>
                            </group>
                        </group>
                    </sheet>
                <chatter/>
                </form>
            </field>
        </record>

        <record id="meeting_view_tree" model="ir.ui.view">
            <field name="name">Parents Meeting</field>
            <field name="model">parent.meeting</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="standard"/>
                    <field name="division"/>
                </list>
            </field>
        </record>

        <record id="meeting_view_pivot" model="ir.ui.view">
            <field name="name">Parents Meeting Pivot</field>
            <field name="model">parent.meeting</field>
            <field name="arch" type="xml">
                <pivot string="Parents Meeting">
                    <field name="name" type="col"/>
                    <field name="standard" type="row"/>
                    <field name="division"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="agenda"/>
                </pivot>
            </field>
        </record>

        <record id="meeting_view_kanban" model="ir.ui.view">
            <field name="name">Parents Meeting Kanban</field>
            <field name="model">parent.meeting</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="standard"/>
                    <field name="division"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="agenda"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                                <div class="oe_kanban_content flex-grow-1">
                                    <div class="oe_kanban_details">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="standard"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="division"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_parent_meeting">
            <field name="name">Parents Meeting</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">parent.meeting</field>
            <field name="view_mode">list,form,pivot,kanban</field>
        </record>

        <menuitem id="hostel_parents__meeting_menu" name="Parents Meeting" 
            parent="hostel_menu" action="action_parent_meeting"/>

    </data>
</odoo>