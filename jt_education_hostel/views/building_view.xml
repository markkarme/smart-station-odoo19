<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hostel_building_form" model="ir.ui.view">
            <field name="name">Hostel Building</field>
            <field name="model">hostel.building</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required='1'></field>
                                <field name="floor"  required='1'></field>
                            </group>
                        </group>
                        <notebook>
                            <page string="Rooms">
                                <field name="room_ids">
                                    <list editable='bottom'>
                                        <field name="name" required='1'></field>
                                        <field name="room_type" required='1'></field>
                                        <field name="capacity" required='1'></field>
                                        <field name="room_bed" required='1'></field>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                <chatter/>
                </form>
            </field>
        </record>

        
        <record id="hostel_building_tree" model="ir.ui.view">
            <field name="name">Hostel Building</field>
            <field name="model">hostel.building</field>
            <field name="arch" type="xml">
                <list> 
                    <field name="name"></field>
                    <field name="floor"></field>
                </list>
            </field>
        </record>


        <record id="hostel_building_pivot" model="ir.ui.view">
            <field name="name">Hostel Building Pivot</field>
            <field name="model">hostel.building</field>
            <field name="arch" type="xml">
                <pivot string="Hostel Building">
                    <field name="name" type="col"></field>
                    <field name="floor"></field>
                    <field name="room_ids"></field>
                </pivot>
            </field>
        </record>


        <record id="hostel_building_kanban" model="ir.ui.view">
            <field name="name">Hostel Building Kanban</field>
            <field name="model">hostel.building</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name" type="col"></field>
                    <field name="floor"></field>
                    <field name="room_ids"></field>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                                <div class="oe_kanban_content flex-grow-1">
                                    <div class="oe_kanban_details">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <strong>Floor : </strong><field name="floor"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        
        <record model="ir.actions.act_window" id="action_hostel_building">
            <field name="name">Hostel Building</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hostel.building</field>
            <field name="view_mode">list,form,pivot,kanban</field>
        </record>


        <menuitem id="hostel_building_menu" name="Building" 
            parent="hostel_menu" action="action_hostel_building"/>

    </data>
</odoo>