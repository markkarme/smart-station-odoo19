<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hostel_room_form" model="ir.ui.view">
            <field name="name">Hostel Room</field>
            <field name="model">hostel.room</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="building_id"  required='1'></field>
                                <field name="name" required='1'></field>
                                <field name="room_type"  required='1'></field>
                            </group>
                            <group>
                                <field name="capacity" required='1'></field>
                                <field name="room_bed"  required='1'></field>
                                <field name="student_ids" widget="many2many_tags" readonly="1"/>
                                <field name="is_capacity_full"/>
                            </group>
                        </group>
                    </sheet>
                <chatter/>
                </form>
            </field>
        </record>

        <record id="hostel_room_tree" model="ir.ui.view">
            <field name="name">Hostel Room</field>
            <field name="model">hostel.room</field>
            <field name="arch" type="xml">
                <list> 
                    <field name="name"></field>
                    <field name="building_id"></field>
                    <field name="room_type"></field>
                    <field name="capacity"></field>
                </list>
            </field>
        </record>


        <record id="hostel_room_pivot" model="ir.ui.view">
            <field name="name">Hostel Room Pivot</field>
            <field name="model">hostel.room</field>
            <field name="arch" type="xml">
                <pivot string="Hostel Room">
                    <field name="name" type="col"></field>
                    <field name="building_id"></field>
                    <field name="room_type"></field>
                    <field name="capacity"></field>
                    <field name="student_ids" type="row"></field>
                </pivot>
            </field>
        </record>

        <record id="hostel_room_kanban" model="ir.ui.view">
            <field name="name">Hostel Room Kanban</field>
            <field name="model">hostel.room</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"></field>
                    <field name="building_id"></field>
                    <field name="room_type"></field>
                    <field name="capacity"></field>
                    <field name="student_ids"></field>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                                <div class="oe_kanban_content flex-grow-1">
                                    <div class="oe_kanban_details">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <strong>Building Name : </strong><field name="building_id"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <strong>Room Type : </strong><field name="room_type"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <strong>Capacity : </strong><field name="capacity"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_hostel_room">
            <field name="name">Hostel Room</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hostel.room</field>
            <field name="view_mode">list,form,pivot,kanban</field>
        </record>

        <menuitem id="hostel_room_menu" name="Room" 
            parent="hostel_menu" action="action_hostel_room"/>

    </data>
</odoo>