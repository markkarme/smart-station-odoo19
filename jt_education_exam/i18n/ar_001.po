"<p>Dear {{ record.student_id.name }},</p>\n"
"                <p>Your result for the exam {{ record.exam_id.name }} has been generated.</p>\n"
"                <p>Total Marks: {{ record.total_mark }}<br/>\n"
"                Marks Scored: {{ record.total_mark_scored }}<br/>\n"
"                Status: {{ 'Pass' if record.pass_fail_full else 'Fail' }}</p>\n"
"                <p>Thank you!</p>\n"
"\n"
"            "
