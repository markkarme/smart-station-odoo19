<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="attendance_summary_report_template">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="result">
                    <div class="page">
                        <t t-set="report_data" t-value="result.get_report_data(data)"/>
                        <div style="padding-top:10px;">
                            <div>
                                <p style="align:center;text-align:center;"><span style="font-size:40px;color:black;" t-field="res_company.name"/></p>
                            </div>
                            <div style="align:center;text-align:center;">
                                <p style="align:center;text-align:color:black;font-size:25px;margin-top:20px;">Attendance Summary Report</p>
                                <p  style="align:center;text-align:center;black;font-size:20px;">
                                    For Divison
                                    <span t-esc="result.division_id.name"/>
                                </p>
                                 <p  style="align:center;text-align:center;color:black;font-size:20px;margin-top:30px;"><strong>From:</strong>
                                 <span t-esc="result.start_date"/>
                                <strong>To:</strong>
                                 <span t-esc="result.end_date"/>
                                </p>
                            </div>
                        </div><br/>
                        <div class="container-justify-content-center text-center">
                            <table class="table table-bordered mb32" style="table-layout:auto">
                                <thead>
                                    <t t-set="unavailable_dates" t-value="result._get_unavailable_dates()"/>
                                    <t t-set="all_dates" t-value="result.get_all_date(result.start_date,result.end_date)"/>
                                    <tr>
                                        <th>Month</th>
                                        <t t-foreach="report_data.get('month_name')" t-as="month_name">
                                            &lt;th class="text-center" colspan=<t t-esc="31"/>&gt;<t t-esc="month_name"/>&lt;/th&gt;
                                        </t>
                                        <th/>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Days</strong>
                                        </td>
                                        <t t-foreach="all_dates" t-as="all_date">
                                            <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                            <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                &lt;td style="background-color:gray;" class="text-center oe_leftfit oe_rightfit"&gt; <t t-esc="all_day"/>&lt;/td&gt;
                                            </t>
                                            <t t-if="all_day not in unavailable_dates[1] and all_date not in unavailable_dates[0]">
                                                 &lt;td class="text-center oe_leftfit oe_rightfit"&gt; <t t-esc="all_day"/>&lt;/td&gt;
                                             </t>
                                        </t>
                                        <td class="text-center" rowspan='2'>Sum</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Class</strong>
                                        </td>
                                        <t t-foreach="all_dates" t-as="all_date">
                                            <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                            <t t-set="date" t-value="all_date.strftime('%d')"/>
                                            <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                &lt;td style="background-color:gray;" class="text-center oe_leftfit oe_rightfit"&gt; <t t-esc="date"/>&lt;/td&gt;
                                            </t>
                                       
                                            <t t-if="all_day not in unavailable_dates[1] and all_date not in unavailable_dates[0]">
                                             &lt;td  class="text-center oe_leftfit oe_rightfit"&gt; <t t-esc="date"/>&lt;/td&gt;
                                            </t>
                                        </t>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="report_data.get('standards')" t-as="std">
                                        <t t-set="std_id" t-value="std.id"/>
                                        <tr>
                                            <td style="padding-left:2%;text-align:left;width: 15%;">
                                                <strong><t t-esc="std.name"/></strong>
                                            </td>
                                            <t t-set="colspan_len" t-value="len(all_dates)+1"/>
                                            <td t-att-colspan='colspan_len'/>
                                        </tr>

                                        <t t-set="total_row_present" t-value="0"/>
                                        <tr>
                                            <td style="padding-left:4%;text-align:left;width: 15%;"><strong>Present</strong></td>
                                            <t t-foreach="all_dates" t-as="all_date">
                                                <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                                <t t-set="present_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.standard_id.id == std_id and x.present)"/>
                                                <t t-set="count_present" t-value="len(present_date)"/>
                                                <t t-set="total_row_present" t-value="total_row_present + count_present"/>
                                                <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                    <td style="background-color:gray;">
                                                        <t t-esc="count_present"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td>
                                                        <t t-esc="count_present"/>
                                                    </td>
                                                </t>
                                            </t>
                                            <td><t t-esc="total_row_present"/></td>
                                        </tr>

                                        <t t-set="total_row_absent" t-value="0"/>
                                        <tr>
                                            <td style="padding-left:4%;text-align:left;width: 15%;"><strong>Absent</strong></td>
                                            <t t-foreach="all_dates" t-as="all_date">
                                                <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                                <t t-set="absent_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.standard_id.id == std_id and x.absence_reason)"/>
                                                <t t-set="count_absent" t-value="len(absent_date)"/>
                                                <t t-set="total_row_absent" t-value="total_row_absent + count_absent"/>
                                                <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                    <td style="background-color:gray;">
                                                        <t t-esc="count_absent"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td>
                                                        <t t-esc="count_absent"/>
                                                    </td>
                                                </t>
                                            </t>
                                            <td><t t-esc="total_row_absent"/></td>
                                        </tr>

                                        <t t-set="total_row_absent_no" t-value="0"/>
                                        <tr>
                                            <td style="padding-left:4%;text-align:left;width: 15%;"><strong>Absent with no Reason</strong></td>
                                            <t t-foreach="all_dates" t-as="all_date">
                                                <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                                <t t-set="absent_nores_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.standard_id.id == std_id and x.absence_noreason)"/>
                                                <t t-set="count_absent_no" t-value="len(absent_nores_date)"/>
                                                <t t-set="total_row_absent_no" t-value="total_row_absent_no + count_absent_no"/>
                                                <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                    <td style="background-color:gray;">
                                                        <t t-esc="count_absent_no"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td>
                                                        <t t-esc="count_absent_no"/>
                                                    </td>
                                                </t>
                                            </t>
                                            <td><t t-esc="total_row_absent_no"/></td>
                                        </tr>

                                        <t t-set="total_row_late" t-value="0"/>
                                        <tr>
                                            <td style="padding-left:4%;text-align:left;width: 15%;"><strong>Late</strong></td>
                                            <t t-foreach="all_dates" t-as="all_date">
                                                <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                                <t t-set="late_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.standard_id.id == std_id and x.late)"/>
                                                <t t-set="count_late" t-value="len(late_date)"/>
                                                <t t-set="total_row_late" t-value="total_row_late + count_late"/>
                                                <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                    <td style="background-color:gray;">
                                                        <t t-esc="count_late"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td>
                                                        <t t-esc="count_late"/>
                                                    </td>
                                                </t>
                                            </t>
                                            <td><t t-esc="total_row_late"/></td>
                                        </tr>

                                        <t t-set="total_row_withdraw" t-value="0"/>
                                        <tr>
                                            <td style="padding-left:4%;text-align:left;width: 15%;"><strong>Withdraw</strong></td>
                                            <t t-foreach="all_dates" t-as="all_date">
                                                <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                                <t t-set="withdraw_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.standard_id.id == std_id and x.withdraw)"/>
                                                <t t-set="count_withdraw" t-value="len(withdraw_date)"/>
                                                <t t-set="total_row_withdraw" t-value="total_row_withdraw + count_withdraw"/>
                                                <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                    <td style="background-color:gray;">
                                                        <t t-esc="count_withdraw"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td>
                                                        <t t-esc="count_withdraw"/>
                                                    </td>
                                                </t>
                                            </t>
                                            <td><t t-esc="total_row_withdraw"/></td>
                                        </tr>
                                    </t>


                                    <tr>
                                        <t t-set="colspan_len" t-value="len(all_dates)+2"/>
                                        <td t-att-colspan='colspan_len'><strong>Total</strong></td>
                                    </tr>
                                        

                                    <t t-set="total_col_present" t-value="0"/>
                                    <t t-set="ttl_row_present" t-value="0"/>
                                    <tr>
                                        <td style="padding-left:4%;text-align:left;width: 15%;" ><strong>Present</strong></td>

                                        <t t-foreach="all_dates" t-as="all_date">
                                            <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                            <t t-set="ttl_present_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.present)"/>
                                            <t t-set="total_col_present" t-value="len(ttl_present_date)"/>
                                            <t t-set="ttl_row_present" t-value="ttl_row_present + total_col_present"/>
                                            <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                <td style="background-color:gray;">
                                                    <t t-esc="total_col_present"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td>
                                                    <t t-esc="total_col_present"/>
                                                </td>
                                            </t>
                                        </t>
                                        <td><t t-esc="ttl_row_present"/></td>
                                    </tr>

                                    <t t-set="ttl_row_absent" t-value="0"/>
                                    <tr>
                                        <td style="padding-left:4%;text-align:left;width: 15%;"><strong>Absent</strong></td>
                                        <t t-foreach="all_dates" t-as="all_date">
                                            <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                            <t t-set="ttl_absent_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and (x.absence_reason or x.absence_noreason))"/>
                                            <t t-set="total_col_absent" t-value="len(ttl_absent_date)"/>
                                            <t t-set="ttl_row_absent" t-value="ttl_row_absent + total_col_absent"/>
                                            <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                <td style="background-color:gray;">
                                                    <t t-esc="total_col_absent"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td>
                                                    <t t-esc="total_col_absent"/>
                                                </td>
                                            </t>
                                        </t>
                                        <td><t t-esc="ttl_row_absent"/></td>
                                    </tr>
                                    <t t-set="ttl_row_absent_nores" t-value="0"/>
                                    <tr>
                                        <td style="padding-left:4%;text-align:left;width: 15%;"><strong>Absent with no Reason</strong></td>
                                        <t t-foreach="all_dates" t-as="all_date">
                                            <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                            <t t-set="ttl_absent_nores_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.absence_noreason)"/>
                                            <t t-set="total_col_absent_nores" t-value="len(ttl_absent_nores_date)"/>
                                            <t t-set="ttl_row_absent_nores" t-value="ttl_row_absent_nores + total_col_absent_nores"/>
                                            <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                <td style="background-color:gray;">
                                                    <t t-esc="total_col_absent_nores"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td>
                                                    <t t-esc="total_col_absent_nores"/>
                                                </td>
                                            </t>
                                        </t>
                                        <td><t t-esc="ttl_row_absent_nores"/></td>
                                    </tr>

                                    <t t-set="ttl_row_late" t-value="0"/>
                                    <tr>
                                        <td style="padding-left:4%;text-align:left;width: 15%;"><strong>Late</strong></td>
                                        <t t-foreach="all_dates" t-as="all_date">
                                            <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                            <t t-set="ttl_late_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.late)"/>
                                            <t t-set="total_col_late" t-value="len(ttl_late_date)"/>
                                            <t t-set="ttl_row_late" t-value="ttl_row_late + total_col_late"/>
                                            <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                <td style="background-color:gray;">
                                                    <t t-esc="total_col_late"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td>
                                                    <t t-esc="total_col_late"/>
                                                </td>
                                            </t>
                                        </t>
                                        <td><t t-esc="ttl_row_late"/></td>
                                    </tr>

                                    <t t-set="ttl_row_withdraw" t-value="0"/>
                                    <tr>
                                        <td style="padding-left:4%;text-align:left;width: 15%;"><strong> Withdraw</strong></td>
                                        <t t-foreach="all_dates" t-as="all_date">
                                            <t t-set="all_day" t-value="all_date.strftime('%a')"/>
                                            <t t-set="ttl_withdraw_date" t-value="report_data.get('attendance_lines_new').filtered(lambda x: x.date == all_date and x.withdraw)"/>
                                            <t t-set="total_col_withdraw" t-value="len(ttl_withdraw_date)"/>
                                            <t t-set="ttl_row_withdraw" t-value="ttl_row_withdraw + total_col_withdraw"/>
                                            <t t-if="all_day in unavailable_dates[1] or all_date in unavailable_dates[0]">
                                                <td style="background-color:gray;">
                                                    <t t-esc="total_col_withdraw"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td>
                                                    <t t-esc="total_col_withdraw"/>
                                                </td>
                                            </t>
                                        </t>
                                        <td><t t-esc="ttl_row_withdraw"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </template>                

        <record id="action_summary_attendance_report" model="ir.actions.report">
            <field name="name">Attendance Summary Report</field>
            <field name="model">print.attendance</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">jt_education_attendance.attendance_summary_report_template</field>
            <field name="report_file">jt_education_attendance.attendance_summary_report_template</field>
            <field name="paperformat_id" ref="jt_education_attendance.attendance_report_template_paperformate"/>
            <field name="print_report_name">'Attendance Summary Report'</field>
            <field name="binding_model_id" ref="jt_education_attendance.model_print_attendance"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
