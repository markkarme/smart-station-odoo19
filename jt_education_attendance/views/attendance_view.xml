<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="attendance_form_view" model="ir.ui.view">
			<field name="name">Attendance Form view</field>
			<field name="model">attendance.attendance</field>
			<field name="arch" type="xml">
				<form>
					<header>
						<button name="select_all_line" type="object" string="تحديد الكل"
							class="btn-secondary" invisible="not attendance_ids"/>
						<button name="present_student" type="object" string="حاضر"
							class="btn-primary" invisible="not attendance_ids"/>
						<button name="absence_reason_student" type="object" string="غائب بسبب"
							class="btn-secondary" invisible="not attendance_ids"/>
						<button name="absence_noreason_student" type="object" string="غائب بدون سبب"
							class="btn-secondary" invisible="not attendance_ids"/>
						<button name="late_student" type="object" string="متأخر"
							class="btn-secondary" invisible="not attendance_ids"/>
						<button name="withdraw_student" type="object" string="سحب"
							class="btn-secondary" invisible="not attendance_ids"/>
						<button name="reminder_absent_student" type="object" string="إرسال تذكير"
							class="btn-primary" invisible="not has_absent_students"/>
					</header>
					<sheet>
						<field name="has_absent_students" invisible="1"/>
						<div class="oe_title">
							<h1>
								<field name="name" readonly="1" class="o_text_overflow"/>
							</h1>
						</div>
						<group>
							<group>
								<field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
								<field name="standard_id" required="1"/>
								<field name="division_id" required="1"/>
								<field name="class_id"/>
							</group>
							<group>
								<field name="date"/>
								<field name="subject_id" widget="many2many_tags"/>
							</group>
						</group>
						<notebook>
							<page string="Attendance">
								<field name="attendance_ids">
									<list editable="bottom">
										<field name="attendance_id" column_invisible="1"/>
										<field name="company_id" column_invisible="1"/>
										<field name="selected"/>
										<field name="standard_id" optional="hide"/>
										<field name="division_id" optional="hide"/>
										<field name="class_id" optional="hide"/>
										<field name="student_id"
											options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True, 'no_create': True}"
											domain="[('is_student', '=', True), ('standard','=',standard_id), ('div','=',division_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
											required="1"/>
										<field name="roll_no"/>
										<field name="present"/>
										<field name="absence_reason"/>
										<field name="absence_noreason"/>
										<field name="late"/>
										<field name="withdraw"/>
										<field name="date"/>
									</list>
								</field>
							</page>
						</notebook>
					</sheet>
					<chatter/>
				</form>
			</field>
		</record>

		<record id="attendance_tree_view" model="ir.ui.view">
			<field name="name">Attendance Tree view</field>
			<field name="model">attendance.attendance</field>
			<field name="arch" type="xml">
				<list>
					<field name="name"/>
					<field name="company_id" groups="base.group_multi_company" optional="show"/>
					<field name="standard_id"/>
					<field name="division_id"/>
					<field name="class_id"/>
					<field name="date" readonly="1"/>
				</list>
			</field>
		</record>

 		<record id="view_attendance_line_graph" model="ir.ui.view">
		        <field name="name">attendance.line.graph</field>
		        <field name="model">attendance.line</field>
		        <field name="arch" type="xml">
		        	<graph string="Attendance Graph" type="bar">
                		<field name="student_id"/>
                		<field name="date"/>
            		</graph>
		        </field>
		</record>


		<!-- attendance action view -->
        <record id="action_attendance" model="ir.actions.act_window">
            <field name="name">Attendance</field>
            <field name="res_model">attendance.attendance</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_report" model="ir.actions.act_window">
            <field name="name">Attendance Reporting</field>
            <field name="res_model">attendance.line</field>
            <field name="view_mode">graph,form</field>
        </record>

        <menuitem name="Attendance" id="attendance_menu" action="action_attendance" parent="jt_education_base.student_root_menu" sequence="2"/>
        <menuitem name="Attendance Reporting" id="attendance_report_menu" action="action_report" parent="jt_education_base.menu_education_reports" sequence="6"/>

	</data>
</odoo>
