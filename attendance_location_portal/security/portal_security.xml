        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">
            Admin attendance portal users can manage student attendance
            (attendance.attendance) for their allowed companies only.
        </field>
    </record>

    <record id="student_attendance_portal_company_rule" model="ir.rule">
        <field name="name">Student Attendance Portal: allowed companies</field>
        <field name="model_id" ref="jt_education_attendance.model_attendance_attendance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_portal_attendance_admin'))]"/>
    </record>

