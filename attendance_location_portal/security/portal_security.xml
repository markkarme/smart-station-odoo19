<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_portal_hr" model="res.groups.privilege">
        <field name="name">Portal HR</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_portal_hr_admin" model="res.groups">
        <field name="name">Portal Admin</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_portal_hr"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">
            Portal admin users can view all attendance records, general requests,
            time off requests, allocations, and attendance adjustments.
        </field>
    </record>
</odoo>
