<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_attendance_adjustment_request_rule_portal" model="ir.rule">
        <field name="name">Portal User: own attendance adjustment requests only</field>
        <field name="model_id" ref="model_hr_attendance_adjustment_request"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="hr_attendance_adjustment_request_rule_company" model="ir.rule">
        <field name="name">Attendance Adjustment Request: multi-company</field>
        <field name="model_id" ref="model_hr_attendance_adjustment_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
