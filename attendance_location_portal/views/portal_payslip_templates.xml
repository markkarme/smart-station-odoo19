<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_home_menu_payslips" inherit_id="portal.portal_breadcrumbs" priority="55">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('portal_payslips', 'portal_payslip_detail', 'portal_payslip_failed')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'portal_payslips' else ''}">
                <a t-if="page_name != 'portal_payslips'" href="/my/payslips"><t>Payslips</t></a>
                <t t-else=""><t>Payslips</t></t>
            </li>
            <li t-if="page_name == 'portal_payslip_detail'" class="breadcrumb-item active">
                <t>Payslip</t>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_payslips_entry" inherit_id="portal.portal_my_home" priority="55">
        <div id="portal_common_category" position="inside">
            <t t-if="request.env.user.sudo().employee_ids" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/hr_payroll/static/description/icon.svg'"/>
                <t t-if="request.env.user.has_group('attendance_location_portal.group_portal_hr_admin')">
                    <t t-set="title">Payslips</t>
                    <t t-set="text">View validated payslips for your companies</t>
                </t>
                <t t-else="">
                    <t t-set="title">My Payslips</t>
                    <t t-set="text">View your payslip after it is validated</t>
                </t>
                <t t-set="url" t-value="'/my/payslips'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <template id="portal_my_payslips" name="My Payslips">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Payslips</t>
            </t>

            <div t-if="not payslips" class="alert alert-info">
                <t>You have no validated payslips yet.</t>
            </div>

            <t t-if="payslips">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th t-if="is_portal_hr_admin"><t>Employee</t></th>
                            <th><t>Payslip</t></th>
                            <th><t>Period</t></th>
                            <th class="text-end"><t>Net Wage</t></th>
                            <th class="text-end"><t>Status</t></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="payslips" t-as="payslip">
                            <td t-if="is_portal_hr_admin">
                                <span t-out="payslip.employee_id.name"/>
                            </td>
                            <td>
                                <a t-att-href="'/my/payslips/%s' % payslip.id">
                                    <span t-out="payslip.name"/>
                                </a>
                            </td>
                            <td>
                                <span t-field="payslip.date_from"/>
                                <span> - </span>
                                <span t-field="payslip.date_to"/>
                            </td>
                            <td class="text-end">
                                <span t-field="payslip.net_wage"/>
                            </td>
                            <td class="text-end">
                                <span t-attf-class="badge rounded-pill #{payslip_state_badges.get(payslip.state, 'text-bg-secondary')}">
                                    <t t-out="payslip_state_labels.get(payslip.state, payslip.state)"/>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </t>
                <div t-if="pager" class="o_portal_pager mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <template id="portal_payslip_detail" name="Payslip">
        <t t-call="portal.portal_layout">
            <div class="container py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h3 class="mb-1" t-out="payslip.name"/>
                        <div class="text-muted">
                            <span t-if="is_portal_hr_admin" t-out="payslip.employee_id.name"/>
                            <span t-if="is_portal_hr_admin"> · </span>
                            <span t-field="payslip.date_from"/>
                            <span> - </span>
                            <span t-field="payslip.date_to"/>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span t-attf-class="badge rounded-pill #{payslip_state_badges.get(payslip.state, 'text-bg-secondary')}">
                            <t t-out="payslip_state_labels.get(payslip.state, payslip.state)"/>
                        </span>
                        <a t-att-href="'/my/payslips/%s/pdf' % payslip.id" class="btn btn-primary" target="_blank">
                            <t>Download</t>
                        </a>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body p-0">
                        <iframe
                            t-att-src="'/my/payslips/%s/pdf' % payslip.id"
                            t-att-title="payslip.name"
                            class="w-100 border-0"
                            style="min-height: 80vh;"
                        />
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_payslip_failed_page" name="Payslip Failed">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="alert alert-warning" role="alert">
                    <span t-out="error_message"/>
                </div>
                <a href="/my/home" class="btn btn-secondary"><t>Back</t></a>
            </div>
        </t>
    </template>
</odoo>
