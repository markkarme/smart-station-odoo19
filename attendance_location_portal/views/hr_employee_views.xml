<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_employee_form_portal_user_button" model="ir.ui.view">
        <field name="name">hr.employee.form.portal.user.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_create_portal_user"
                    type="object"
                    string="Create Portal User"
                    class="btn-secondary"
                    invisible="user_id"
                    groups="hr.group_hr_user"
                />
                <button
                    name="action_create_portal_admin_user"
                    type="object"
                    string="Create Portal Admin User"
                    class="btn-secondary"
                    invisible="user_id"
                    groups="hr.group_hr_user"
                />
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_form_attendance_locations" model="ir.ui.view">
        <field name="name">hr.employee.form.attendance.locations</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_location_id']" position="after">
                <field
                    name="attendance_location_ids"
                    widget="many2many_tags"
                    options="{'no_create_edit': True}"
                    groups="hr.group_hr_user"
                />
                <field
                    name="is_portal_hr_admin"
                    invisible="not user_id"
                    groups="hr.group_hr_user"
                />
                <field
                    name="is_portal_attendance_admin"
                    invisible="not user_id"
                    groups="hr.group_hr_user"
                />
                <field
                    name="is_portal_exam_admin"
                    invisible="not user_id"
                    groups="hr.group_hr_user"
                />
                <field
                    name="is_portal_mold_admin"
                    invisible="not user_id"
                    groups="hr.group_hr_user"
                />
                <field
                    name="is_portal_fee_admin"
                    invisible="not user_id"
                    groups="hr.group_hr_user"
                />
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_form_multi_approvers" model="ir.ui.view">
        <field name="name">hr.employee.form.multi.approvers</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='managers']" position="replace">
                <group name="managers" string="Approvers">
                    <field name="hr_responsible_ids" widget="many2many_tags" domain="[('share', '=', False)]"/>
                    <field name="expense_manager_ids" widget="many2many_tags" domain="[('share', '=', False)]"/>
                    <field name="leave_manager_ids" widget="many2many_tags" domain="['|', ('share', '=', False), ('portal_hr_admin', '=', True)]"/>
                    <field name="attendance_manager_ids" widget="many2many_tags" domain="[('share', '=', False)]"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
