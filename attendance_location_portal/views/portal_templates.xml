<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_home_menu_attendance" inherit_id="portal.portal_breadcrumbs" priority="50">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('portal_attendance', 'portal_attendance_success', 'portal_attendance_failed')"
                class="breadcrumb-item active">
                Take Attendance
            </li>
            <li t-if="page_name == 'portal_attendance_history'"
                class="breadcrumb-item active">
                My Attendances
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_attendance_entry" inherit_id="portal.portal_my_home" priority="50">
        <div id="portal_common_category" position="inside">
            <t t-set="is_portal_hr_admin" t-value="request.env.user.has_group('attendance_location_portal.group_portal_hr_admin')"/>
            <t t-if="request.env.user.sudo().employee_ids" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/hr_attendance/static/description/icon.svg'"/>
                <t t-set="title">Take Attendance</t>
                <t t-set="text">Check in and check out from your allowed location</t>
                <t t-set="url" t-value="'/my/attendance'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
            <t t-if="request.env.user.sudo().employee_ids" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/hr_attendance/static/description/icon.svg'"/>
                <t t-if="is_portal_hr_admin">
                    <t t-set="title">All Attendances</t>
                    <t t-set="text">View all employees check-in and check-out history</t>
                </t>
                <t t-else="">
                    <t t-set="title">My Attendances</t>
                    <t t-set="text">View your check-in and check-out history</t>
                </t>
                <t t-set="url" t-value="'/my/attendances'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <template id="portal_attendance_page" name="Portal Attendance Page">
        <t t-call="portal.portal_layout">
            <div class="container py-4 portal-attendance">
                <div class="portal-attendance-card shadow-sm">
                    <div class="portal-attendance-header">
                        <h3 class="mb-1">Take Attendance</h3>
                        <p class="mb-0 text-muted">
                            Welcome <strong t-out="employee.name"/>, use your live location to submit attendance.
                        </p>
                    </div>

                    <div class="portal-attendance-body">
                        <div class="attendance-status mb-3">
                            <span class="badge rounded-pill bg-info text-dark">
                                Current status:
                                <t t-if="attendance_state == 'checked_in'">Checked In</t>
                                <t t-else="">Checked Out</t>
                            </span>
                        </div>

                        <div class="mb-3">
                            <h6 class="mb-2">Configured Locations</h6>
                            <t t-if="locations">
                                <ul class="list-group list-group-flush border rounded">
                                    <t t-foreach="locations" t-as="location">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>
                                                <strong t-out="location.name"/> -
                                                <span t-out="'%.0f' % location.allowed_range_m"/> m
                                            </span>
                                            <a t-if="location.google_maps_url"
                                               t-att-href="location.google_maps_url"
                                               class="btn btn-sm btn-outline-primary"
                                               target="_blank">
                                                Open Map
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </t>
                            <t t-else="">
                                <div class="alert alert-warning mb-0">
                                    No attendance locations are configured yet.
                                </div>
                            </t>
                        </div>

                        <form
                            id="portal_attendance_form"
                            method="post"
                            action="/my/attendance/submit"
                            class="mt-3"
                            data-check-url="/my/attendance/check_location"
                        >
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" id="attendance_latitude" name="latitude"/>
                            <input type="hidden" id="attendance_longitude" name="longitude"/>

                            <div class="mb-3">
                                <label class="form-label">نوع الحركة</label>
                                <div class="attendance-action-options d-flex flex-wrap gap-3">
                                    <div class="form-check">
                                        <input
                                            class="form-check-input"
                                            type="radio"
                                            name="attendance_action"
                                            id="attendance_action_check_in"
                                            value="check_in"
                                            required="required"
                                        />
                                        <label class="form-check-label" for="attendance_action_check_in">
                                            تسجيل حضور
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input
                                            class="form-check-input"
                                            type="radio"
                                            name="attendance_action"
                                            id="attendance_action_check_out"
                                            value="check_out"
                                        />
                                        <label class="form-check-label" for="attendance_action_check_out">
                                            تسجيل انصراف
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div id="geo_feedback" class="alert alert-secondary mb-3" role="alert">
                                Detecting your location...
                            </div>

                            <div id="geo_out_of_range_block" class="mb-3 d-none">
                                <h6 class="mb-2">Allowed Locations</h6>
                                <ul id="geo_allowed_locations" class="list-group list-group-flush border rounded"/>
                            </div>

                            <div class="mb-3">
                                <label for="attendance_note" class="form-label">ملاحظة (اختياري)</label>
                                <textarea
                                    id="attendance_note"
                                    name="note"
                                    class="form-control"
                                    rows="3"
                                    placeholder="ملاحظة اختيارية (تستخدم عند تسجيل الانصراف)..."
                                />
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <button id="submit_attendance_btn" type="submit" class="btn btn-primary" disabled="disabled">
                                    تسجيل
                                </button>
                                <button id="refresh_geo_btn" type="button" class="btn btn-outline-secondary">
                                    تحديث الموقع
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_attendance_success_page" name="Portal Attendance Success">
        <t t-call="portal.portal_layout">
            <div class="container py-5 portal-attendance-result">
                <div class="result-card success shadow-sm">
                    <div class="result-icon">
                        <span class="fa fa-check-circle"/>
                    </div>
                    <h3 class="mb-2">تم تسجيل الحضور بنجاح</h3>
                    <p class="text-muted mb-3">
                        <strong t-if="action == 'check_in'">حضور</strong>
                        <strong t-else="">انصراف</strong>
                        تم التسجيل في
                        <strong t-out="location"/>.
                    </p>
                    <div t-if="warning_message" class="alert alert-warning text-start mb-3" role="alert">
                        <span t-out="warning_message"/>
                    </div>
                    <a href="/my/attendance" class="btn btn-primary">العودة إلى تسجيل الحضور</a>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_attendance_duplicate_checkin_page" name="Portal Attendance Duplicate Check In">
        <t t-call="portal.portal_layout">
            <div class="container py-5 portal-attendance-result">
                <div class="result-card failed shadow-sm">
                    <div class="result-icon">
                        <span class="fa fa-exclamation-triangle"/>
                    </div>
                    <h3 class="mb-2">رسالة تحقق</h3>
                    <p class="text-muted mb-3" t-out="warning_message"/>
                    <div class="d-flex flex-wrap gap-2">
                        <form method="post" action="/my/attendance/submit" class="m-0">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="force_check_in" value="1"/>
                            <input type="hidden" name="latitude" t-att-value="post_values.get('latitude')"/>
                            <input type="hidden" name="longitude" t-att-value="post_values.get('longitude')"/>
                            <input type="hidden" name="attendance_action" t-att-value="post_values.get('attendance_action')"/>
                            <input type="hidden" name="note" t-att-value="post_values.get('note')"/>
                            <button type="submit" class="btn btn-primary">متابعة</button>
                        </form>
                        <a href="/my/attendance" class="btn btn-outline-secondary">العودة إلى صفحة الحضور</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_attendances" name="My Attendances">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">All Attendances</t>
                <t t-if="not is_portal_hr_admin">
                    <t t-set="title">My Attendances</t>
                </t>
            </t>

            <div t-if="attendance_group_context" class="alert alert-light d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>
                    <t t-out="attendance_group_context['label']"/>:
                    <strong t-out="attendance_group_context['name']"/>
                </span>
                <a t-att-href="attendance_group_context['back_url']" class="btn btn-sm btn-outline-secondary">
                    <t>Back to groups</t>
                </a>
            </div>

            <div t-if="not attendances and not attendance_groups" class="alert alert-info">
                <t t-if="is_portal_hr_admin">No attendance records found.</t>
                <t t-else="">You have no attendance records yet.</t>
            </div>

            <t t-if="attendance_groups">
                <t t-set="classes" t-value="'portal-attendance-groups'"/>
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>
                                <t t-if="groupby == 'employee'">Employee</t>
                                <t t-else="">Company</t>
                            </th>
                            <th class="text-end text-nowrap">Records</th>
                            <th class="text-end text-nowrap">Worked Hours</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="attendance_groups" t-as="attendance_group">
                            <td>
                                <a t-att-href="attendance_group['url']">
                                    <t t-out="attendance_group['name']"/>
                                </a>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-out="attendance_group['count']"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-out="attendance_group['hours']"/>
                            </td>
                        </tr>
                    </tbody>
                </t>
                <div t-if="pager" class="o_portal_pager mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </t>

            <t t-if="attendances">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th t-if="is_portal_hr_admin">Employee</th>
                            <th class="d-md-none">Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th class="text-end">Worked Hours</th>
                            <th>Location</th>
                            <th>Note</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="attendances" t-as="attendance">
                            <td t-if="is_portal_hr_admin">
                                <span t-out="attendance.employee_id.name"/>
                            </td>
                            <td class="d-md-none text-nowrap">
                                <span t-field="attendance.date"/>
                            </td>
                            <td>
                                <span class="d-none d-md-inline" t-field="attendance.check_in"/>
                                <span class="d-md-none" t-field="attendance.check_in" t-options="{'widget': 'datetime', 'time_only': True, 'hide_seconds': True}"/>
                            </td>
                            <td>
                                <t t-if="attendance.check_out">
                                    <span class="d-none d-md-inline" t-field="attendance.check_out"/>
                                    <span class="d-md-none" t-field="attendance.check_out" t-options="{'widget': 'datetime', 'time_only': True, 'hide_seconds': True}"/>
                                </t>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td class="text-end">
                                <span t-if="attendance.worked_hours" t-out="'%.2f' % attendance.worked_hours"/>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td>
                                <span t-if="attendance.attendance_location_id" t-out="attendance.attendance_location_id.name"/>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td>
                                <span t-if="attendance.portal_note" t-out="attendance.portal_note"/>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td class="text-end">
                                <span t-if="not attendance.check_out" class="badge rounded-pill text-bg-success">Checked In</span>
                                <span t-else="" class="badge rounded-pill text-bg-secondary">Completed</span>
                            </td>
                        </tr>
                    </tbody>
                </t>
                <div t-if="pager" class="o_portal_pager mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <template id="portal_avatar_upload" name="Portal Avatar Upload">
        <form action="/my/account/image" method="post" enctype="multipart/form-data" t-attf-class="o_portal_avatar_form {{'' if compact else 'mb-4'}}">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="redirect" t-att-value="redirect or '/my/home'"/>
            <div t-if="not compact and request.params.get('image_updated')" class="alert alert-success py-2" role="status">
                Photo updated.
            </div>
            <div t-if="not compact and request.params.get('image_error')" class="alert alert-danger py-2" role="alert">
                <t t-if="request.params.get('image_error') == 'type'">Please choose an image file.</t>
                <t t-elif="request.params.get('image_error') == 'size'">The image is too large. Maximum size is 5 MB.</t>
                <t t-else="">The image could not be updated.</t>
            </div>
            <label class="o_portal_avatar_picker mb-0">
                <img class="rounded object-fit-cover"
                     t-att-src="image_data_uri(request.env.user.partner_id.avatar_128)"
                     alt="Contact"
                     t-att-width="96 if not compact else 50"
                     t-att-height="96 if not compact else 50"/>
                <span class="o_portal_avatar_camera" title="Change photo">
                    <i class="fa fa-camera"/>
                </span>
                <input type="file"
                       name="image"
                       accept="image/png,image/jpeg,image/webp,image/gif"
                       class="d-none"
                       onchange="this.form.submit()"/>
            </label>
            <div t-if="not compact" class="small text-muted mt-2">Change photo</div>
        </form>
    </template>

    <template id="portal_side_avatar_upload" inherit_id="portal.side_content" name="Portal Sidebar Avatar Upload">
        <xpath expr="//div[hasclass('d-flex')]" position="before">
            <div t-if="request.params.get('image_updated')" class="alert alert-success py-2" role="status">
                Photo updated.
            </div>
            <div t-if="request.params.get('image_error')" class="alert alert-danger py-2" role="alert">
                <t t-if="request.params.get('image_error') == 'type'">Please choose an image file.</t>
                <t t-elif="request.params.get('image_error') == 'size'">The image is too large. Maximum size is 5 MB.</t>
                <t t-else="">The image could not be updated.</t>
            </div>
        </xpath>
        <xpath expr="//img[hasclass('object-fit-cover')]" position="replace">
            <t t-call="attendance_location_portal.portal_avatar_upload">
                <t t-set="compact" t-value="True"/>
                <t t-set="redirect" t-value="'/my/home'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_details_avatar_upload" inherit_id="portal.portal_my_details" name="Portal Details Avatar Upload">
        <xpath expr="//form[@name='address_form']" position="before">
            <t t-call="attendance_location_portal.portal_avatar_upload">
                <t t-set="redirect" t-value="'/my/account'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_attendance_failed_page" name="Portal Attendance Failed">
        <t t-call="portal.portal_layout">
            <div class="container py-5 portal-attendance-result">
                <div class="result-card failed shadow-sm">
                    <div class="result-icon">
                        <span class="fa fa-times-circle"/>
                    </div>
                    <h3 class="mb-2">Attendance Failed</h3>
                    <p class="text-muted mb-3" t-out="error_message"/>
                    <a href="/my/attendance" class="btn btn-outline-danger">Try Again</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
