<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_insurance_response_form" model="ir.ui.view">
        <field name="name">health.insurance.response.form</field>
        <field name="model">health.insurance.response</field>
        <field name="arch" type="xml">
            <form string="Health Insurance Response">
                <sheet>
                    <div class="oe_title">
                        <h1>جواب التأمين الصحي</h1>
                        <p class="text-muted">نسختان من طلب توقيع الكشف الطبي على نفس الصفحة</p>
                    </div>
                    <group>
                        <group>
                            <field name="student_name"/>
                            <field name="insurance_number" placeholder="رقم بطاقة التأمين الصحي"/>
                        </group>
                        <group>
                            <field name="region"/>
                            <field name="station"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" type="object" string="Download PDF" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_health_insurance_response" model="ir.actions.act_window">
        <field name="name">Health Insurance Response</field>
        <field name="res_model">health.insurance.response</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_health_insurance_response_form"/>
    </record>

    <menuitem id="menu_health_insurance_response"
              name="Health Insurance Response"
              parent="jt_education_base.student_root_menu"
              action="action_health_insurance_response"
              sequence="18"/>
</odoo>
