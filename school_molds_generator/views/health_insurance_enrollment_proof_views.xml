<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_insurance_enrollment_proof_form" model="ir.ui.view">
        <field name="name">health.insurance.enrollment.proof.form</field>
        <field name="model">health.insurance.enrollment.proof</field>
        <field name="arch" type="xml">
            <form string="Health Insurance Enrollment Proof 2">
                <sheet>
                    <div class="oe_title">
                        <h1>اثبات اشتراك التأمين الصحي</h1>
                        <p class="text-muted">قبول اشتراك التأمين الصحي للطلاب المدرجين في الكشف المرفق</p>
                    </div>
                    <group>
                        <group>
                            <field name="student_count"/>
                            <field name="academic_year" placeholder="2026/2025"/>
                        </group>
                        <group>
                            <field name="region"/>
                            <field name="station"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" type="object" string="Download PDF" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_health_insurance_enrollment_proof" model="ir.actions.act_window">
        <field name="name">Health Insurance Enrollment Proof 2</field>
        <field name="res_model">health.insurance.enrollment.proof</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_health_insurance_enrollment_proof_form"/>
    </record>

    <menuitem id="menu_health_insurance_enrollment_proof"
              name="Health Insurance Enrollment Proof 2"
              parent="jt_education_base.student_root_menu"
              action="action_health_insurance_enrollment_proof"
              sequence="17"/>
</odoo>
