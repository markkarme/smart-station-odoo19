<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_proof_registration_letter_form" model="ir.ui.view">
        <field name="name">proof.registration.letter.form</field>
        <field name="model">proof.registration.letter</field>
        <field name="arch" type="xml">
            <form string="Proof of Registration">
                <sheet>
                    <div class="oe_title">
                        <h1>اثبات قيد / افادة</h1>
                        <p class="text-muted">إفادة بقيد الطالب في المحطة</p>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="student_name"/>
                            <field name="addressee" placeholder="الجهة الموجه إليها"/>
                            <field name="national_id"/>
                        </group>
                        <group>
                            <field name="class_name"/>
                            <field name="specialization"/>
                            <field name="academic_year" placeholder="2025/2026"/>
                            <field name="region"/>
                            <field name="station"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" type="object" string="Download PDF" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_proof_registration_letter" model="ir.actions.act_window">
        <field name="name">Proof of Registration</field>
        <field name="res_model">proof.registration.letter</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_proof_registration_letter_form"/>
    </record>

    <menuitem id="menu_proof_registration_letter"
              name="Proof of Registration"
              parent="jt_education_base.student_root_menu"
              action="action_proof_registration_letter"
              sequence="16"/>
</odoo>
