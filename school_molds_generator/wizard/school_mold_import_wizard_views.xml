<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_mold_import_wizard_view_form" model="ir.ui.view">
        <field name="name">school.mold.import.wizard.form</field>
        <field name="model">school.mold.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Excel">
                <group>
                    <field name="mold_id" invisible="1"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <p class="text-muted">Upload an Excel file exported from this mold (or with the same column headers). Existing sheet rows will be replaced with the file data.</p>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_mold_import_wizard" model="ir.actions.act_window">
        <field name="name">Upload Excel</field>
        <field name="res_model">school.mold.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="school_mold_import_wizard_view_form"/>
    </record>
</odoo>
