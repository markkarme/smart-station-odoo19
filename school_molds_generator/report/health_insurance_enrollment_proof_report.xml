<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_health_insurance_enrollment_proof" model="report.paperformat">
        <field name="name">Health Insurance Enrollment Proof A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <template id="report_health_insurance_enrollment_proof">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article page" dir="rtl" lang="ar">
                    <style type="text/css">
                        <t t-out="o.get_arabic_font_face_css()"/>
                        .article, .page, .o_report_layout_standard, .o_report_layout_boxed {
                            border: none !important;
                            box-shadow: none !important;
                        }
                        .o_health_enrollment,
                        .o_health_enrollment * {
                            font-family: 'ReportArabic', 'DejaVu Sans', sans-serif !important;
                            color: #000;
                            border: none !important;
                            box-shadow: none !important;
                            outline: none !important;
                        }
                        .o_health_enrollment {
                            direction: rtl;
                        }
                        .o_he_header {
                            width: 100%;
                            overflow: hidden;
                            margin-bottom: 8px;
                        }
                        .o_he_header_text {
                            float: right;
                            width: 34%;
                            text-align: right;
                            font-size: 13px;
                            line-height: 1.55;
                            font-weight: bold;
                        }
                        .o_he_header_logo {
                            float: right;
                            width: 22%;
                            text-align: center;
                            padding-top: 4px;
                        }
                        .o_he_header_logo img {
                            max-height: 80px;
                            max-width: 120px;
                        }
                        .o_he_signatures {
                            width: 100%;
                            overflow: hidden;
                            margin-top: 80px;
                            font-size: 18px;
                            font-weight: bold;
                        }
                        .o_he_sig {
                            float: right;
                            width: 50%;
                            text-align: center;
                        }
                    </style>

                    <div class="o_health_enrollment" style="direction: rtl;">
                        <div class="o_he_header">
                            <div class="o_he_header_text">
                                <div>جمهورية مصر العربية</div>
                                <div>وزارة الصناعة</div>
                                <div>مصلحة الكفاية الإنتاجية</div>
                                <div><t t-esc="o.region or 'منطقة شمال الصعيد'"/></div>
                                <div><t t-esc="o.station or 'محطة سمارت'"/></div>
                            </div>
                            <div class="o_he_header_logo">
                                <img t-att-src="o.get_asset_data_uri('ministry_of_industry.png')"/>
                            </div>
                            <div class="o_he_header_logo">
                                <img t-att-src="o.get_asset_data_uri('pvtd_image.png')" style="max-height: 70px; max-width: 140px;"/>
                            </div>
                            <div class="o_he_header_logo">
                                <img t-att-src="o.get_asset_data_uri('smart-logo.png')" style="max-height: 70px; max-width: 140px;"/>
                            </div>
                        </div>

                        <div style="clear: both; height: 56px;"></div>

                        <div style="text-align: center; font-size: 18px; font-weight: bold; line-height: 2.3;">
                            <div style="margin-bottom: 22px;">السيد وكيل مديرية التامين الصحي</div>
                            <div style="margin-bottom: 28px;">تحية طيبة وبعد،،،</div>
                            <div style="margin: 0 auto 28px; max-width: 92%; line-height: 2.1;">
                                الرجاء من سيادتكم قبول اشتراك التامين الصحي هذا يعد اثبات قيد لهؤلاء الطلاب المدرج اسمائهم في الكشف المرفق
                                <t t-if="o.student_count"><t t-esc="o.student_count"/></t>
                                <t t-else="">......</t>طالب.
                            </div>
                            <div style="margin-bottom: 28px;">
                                لسيادتكم لعام
                                <t t-esc="o.academic_year or '........../..........'"/>
                            </div>
                            <div>ولكم جزيل الشكر ،،</div>
                        </div>

                        <div class="o_he_signatures">
                            <div class="o_he_sig"></div>
                            <div class="o_he_sig">مدير المحطة</div>
                        </div>
                        <div style="clear: both;"></div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_health_insurance_enrollment_proof" model="ir.actions.report">
        <field name="name">Health Insurance Enrollment Proof 2</field>
        <field name="model">health.insurance.enrollment.proof</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_molds_generator.report_health_insurance_enrollment_proof</field>
        <field name="report_file">school_molds_generator.report_health_insurance_enrollment_proof</field>
        <field name="print_report_name">'اثبات اشتراك التأمين الصحي - %s' % (object.academic_year or '')</field>
        <field name="paperformat_id" ref="paperformat_health_insurance_enrollment_proof"/>
    </record>
</odoo>
