<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_student_fees" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.student.fee.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="after">
                <block title="Student Fee Accounting" id="student_fee_accounting">
                    <setting string="Fee Income Products"
                             help="Products used when creating invoices from installments and other fees.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="fee_product_basic_id" class="col-lg-4 o_light_label"/>
                                <field name="fee_product_basic_id" class="col-lg-6"/>
                            </div>
                            <div class="row mt8">
                                <label for="fee_product_bus_id" class="col-lg-4 o_light_label"/>
                                <field name="fee_product_bus_id" class="col-lg-6"/>
                            </div>
                            <div class="row mt8">
                                <label for="fee_product_books_id" class="col-lg-4 o_light_label"/>
                                <field name="fee_product_books_id" class="col-lg-6"/>
                            </div>
                            <div class="row mt8">
                                <label for="fee_product_uniform_id" class="col-lg-4 o_light_label"/>
                                <field name="fee_product_uniform_id" class="col-lg-6"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
