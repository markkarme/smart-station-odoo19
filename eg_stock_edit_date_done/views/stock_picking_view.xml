<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_inherit_view" model="ir.ui.view">
        <field name="name">stock.picking.form.update.effective.date</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="update_date_done"
                        type="object"
                        string="Update Effective Date"
                        class="btn-secondary"
                        groups="eg_stock_edit_date_done.update_effective_date"
                        invisible="state not in ('done', 'cancel')"/>
            </xpath>
            <!-- Keep date visible on cancelled transfers when a done date exists -->
            <xpath expr="//field[@name='date_done']" position="attributes">
                <attribute name="invisible">state not in ('done', 'cancel')</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
