<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="privilege_attendance_sheet" model="res.groups.privilege">
            <field name="name">Attendance Sheet</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="sequence">80</field>
        </record>

        <record id="group_attendance_sheet_user" model="res.groups">
            <field name="name">Attendance Sheet User</field>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="privilege_id" ref="rm_hr_attendance_sheet.privilege_attendance_sheet"/>
            <field name="sequence">10</field>
        </record>


        <record id="group_attendance_sheet_manager" model="res.groups">
            <field name="name">Attendance Sheet Manager</field>
            <field name="implied_ids"
                   eval="[(4, ref('group_attendance_sheet_user'))]"/>
            <field name="privilege_id" ref="rm_hr_attendance_sheet.privilege_attendance_sheet"/>
            <field name="sequence">20</field>

        </record>

    </data>
</odoo>
