<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_violation_company_rule" model="ir.rule">
        <field name="name">مخالفة الطالب: متعدد الشركات</field>
        <field name="model_id" ref="model_student_violation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="student_case_study_company_rule" model="ir.rule">
        <field name="name">دراسة الحالة: متعدد الشركات</field>
        <field name="model_id" ref="model_student_case_study"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="student_case_study_family_company_rule" model="ir.rule">
        <field name="name">التكوين الأسري لدراسة الحالة: متعدد الشركات</field>
        <field name="model_id" ref="model_student_case_study_family"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
