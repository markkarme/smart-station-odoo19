#. module: jt_education_attendance
#: model:mail.template,body_html:jt_education_attendance.absent_student_template
msgid ""
"<div style=\"font-family: Arial, sans-serif; color: #333; line-height: 1.6;\">\n"
"                    <div style=\"text-align: center; margin-bottom: 20px;\">\n"
"                        <h2 style=\"color: #555;\">Attendance Alert</h2>\n"
"                    </div>\n"
"                    \n"
"                    <p>Dear <t t-out=\"ctx.get('parent').name\"/>,</p>\n"
"\n"
"                    <p>\n"
"                        We hope this message finds you well. We want to inform you that the following \n"
"                        student(s) were marked <strong>absent</strong> today (<t t-out=\"ctx.get('date')\"/>):\n"
"                    </p>\n"
"\n"
"                    <div>\n"
"                        <t t-foreach=\"ctx.get('absent_students', [])\" t-as=\"absent\">\n"
"                            <div style=\"margin-bottom: 10px; border-left: 3px solid #dc3545;\">\n"
"                                <strong>Student:</strong> <t t-out=\"absent.student_id.name\"/><br/>\n"
"                            </div>\n"
"                        </t>\n"
"                    </div>\n"
"\n"
"                    <p>If any of these absences were not pre-approved, we encourage you to contact us for clarification.</p>\n"
"\n"
"                    <p style=\"margin-top: 30px;\">Best regards,</p>\n"
"                    <p><strong><t t-out=\"object.faculty_id.name\"/></strong><br/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; color: #333; line-height: 1.6;\">\n"
"                    <div style=\"text-align: center; margin-bottom: 20px;\">\n"
"                        <h2 style=\"color: #555;\">تنبيه الحضور</h2>\n"
"                    </div>\n"
"                    \n"
"                    <p>عزيزي/عزيزتي <t t-out=\"ctx.get('parent').name\"/>,</p>\n"
"\n"
"                    <p>\n"
"                        نأمل أن تصلك هذه الرسالة وأنت بخير. نود إبلاغك بأن التالي \n"
"                        من الطلاب تم تسجيلهم <strong>غائباً</strong> اليوم (<t t-out=\"ctx.get('date')\"/>):\n"
"                    </p>\n"
"\n"
"                    <div>\n"
"                        <t t-foreach=\"ctx.get('غائباً_students', [])\" t-as=\"غائباً\">\n"
"                            <div style=\"margin-bottom: 10px; border-left: 3px solid #dc3545;\">\n"
"                                <strong>الطالب:</strong> <t t-out=\"غائباً.student_id.name\"/><br/>\n"
"                            </div>\n"
"                        </t>\n"
"                    </div>\n"
"\n"
"                    <p>إذا لم يكن أي من هذه الغيابات موافقاً عليه مسبقاً، يرجى التواصل معنا للتوضيح.</p>\n"
"\n"
"                    <p style=\"margin-top: 30px;\">مع أطيب التحيات،</p>\n"
"                    <p><strong><t t-out=\"object.faculty_id.name\"/></strong><br/>\n"
"                    </p>\n"
"                </div>\n"
"            "

