#. module: jt_education_base
#: model:mail.template,body_html:jt_education_base.send_by_mail_template_remainder4
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Fee Details</p>\n"
"                    <p><strong>Fee Remainder:</strong></p>\n"
"                    <p>Kindly pay fees as mentioned.</p>\n"
"                    <p>Your outstanding fees: <strong><t t-out=\"ctx.get('fees') or ''\"/></strong></p>\n"
"                    <p>Thank you.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>تفاصيل الرسوم</p>\n"
"                    <p><strong>متبقي الرسوم:</strong></p>\n"
"                    <p>يرجى سداد الرسوم كما هو مذكور.</p>\n"
"                    <p>رسومك المستحقة: <strong><t t-out=\"ctx.get('fees') or ''\"/></strong></p>\n"
"                    <p>شكراً لك.</p>\n"
"                </div>\n"
"            "

#. module: jt_education_base
#: model:mail.template,body_html:jt_education_base.admission_successfull_template1
msgid ""
"<div>\n"
"                    <p>Your Admission is Confirmed</p>\n"
"                    <p>\n"
"                        You need to visit campus and need to complete further procedure.\n"
"                        Procedure can be filling out forms and fees payment.\n"
"                    </p>\n"
"                    <p>Your outstanding fees: <strong><t t-out=\"ctx.get('fees') or ''\"/></strong></p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>تم تأكيد قبولك</p>\n"
"                    <p>\n"
"                        يلزمك زيارة الحرم وإكمال الإجراءات المتبقية.\n"
"                        قد تشمل الإجراءات تعبئة النماذج وسداد الرسوم.\n"
"                    </p>\n"
"                    <p>رسومك المستحقة: <strong><t t-out=\"ctx.get('fees') or ''\"/></strong></p>\n"
"                </div>\n"
"            "

#. module: jt_education_base
#: model:mail.template,body_html:jt_education_base.admission_pending_fees_template
msgid ""
"<div>\n"
"                    <p>Your Fees Pending</p>\n"
"                    <p>\n"
"                        Your Application is submitted but the date is closed kindly pay your fees.\n"
"                    </p>\n"
"                    <p>Your outstanding fees: <strong><t t-out=\"ctx.get('fees') or ''\"/></strong></p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>رسومك معلّقة</p>\n"
"                    <p>\n"
"                        تم تقديم طلبك لكن الموعد انتهى، يرجى سداد الرسوم.\n"
"                    </p>\n"
"                    <p>رسومك المستحقة: <strong><t t-out=\"ctx.get('fees') or ''\"/></strong></p>\n"
"                </div>\n"
"            "

#. module: jt_education_base
#: model:mail.template,body_html:jt_education_base.admission_cancel_template
