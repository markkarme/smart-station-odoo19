<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View employee.penalty View list -->
    <record id="view_employee_penalty_list" model="ir.ui.view">
        <field name="name">view.employee.penalty.list</field>
        <field name="model">employee.penalty</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="penalty_type_id"/>
                <field name="date"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'draft'" decoration-danger="state == 'rejected'" decoration-info="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- View employee.penalty form -->
    <record id="view_employee_penalty_form" model="ir.ui.view">
        <field name="name">view.employee.penalty.form</field>
        <field name="model">employee.penalty</field>
        <field name="arch" type="xml">
            <form string="Employee Penalty">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="approved,draft,discounted"/>
                    <button string="Approve" name="action_approve" type="object" class="oe_highlight" invisible="state!='draft'"/>
                    <button string="Cancel" name="action_cancel" type="object" class="btn btn-danger" invisible="state!='approved'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create':1}"/>
                            <field name="currency_id" invisible="1" />
                        </group>
                        <group>
                            <field name="penalty_type_id" string="Penalty" readonly="state != 'draft'" options="{'no_open':1,'no_create':1}"/>
                        </group>
                        <group>
                            <group>
                                <field name="date" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="month" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="year" widget="char"/>
                            </group>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action employee.penalty -->
    <record id="action_employee_penalty" model="ir.actions.act_window">
        <field name="name">Employee Penalty</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.penalty</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Employee Penalty.
            </p>
        </field>
    </record>

    <menuitem
        id="employee_penalty_menu"
        name="Employee Penalties"
        action="action_employee_penalty"
        parent="menu_penalty_root"
        sequence="1"/>

</odoo>
